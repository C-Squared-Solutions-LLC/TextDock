<Window x:Class="TextDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TextDock"
        Width="860" Height="720" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBg}"
        UseLayoutRounding="True">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. Empty space is reported as caption by WM_NCHITTEST (MainWindow.Chrome.cs). -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pulses orange while a starred conversation waits for your reply (MainWindow.Alert.cs). -->
            <Border x:Name="AlertOverlay" Grid.ColumnSpan="2" Background="#FFFB8C00" Opacity="0"
                    IsHitTestVisible="False" />

            <StackPanel Orientation="Horizontal">
                <!-- Opens Messages' own menu while compact mode hides the page's top bar. -->
                <Button x:Name="PageMenuButton" Style="{StaticResource ChromeButton}" FontSize="13" Visibility="Collapsed"
                        Content="&#xE700;" ToolTip="Messages menu" Click="PageMenuButton_Click" />
                <StackPanel x:Name="TitleContent" Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,0,0"
                            IsHitTestVisible="False">
                    <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="TitleText" Text="TextDock" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                               Foreground="{DynamicResource ChromeFg}" />
                    <Border x:Name="UnreadBadge" Visibility="Collapsed" Margin="8,0,0,0" Padding="5,0"
                            MinWidth="16" Height="16" CornerRadius="8" Background="#FFE53935" VerticalAlignment="Center">
                        <TextBlock x:Name="UnreadText" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- "<name> needs a reply": opens that conversation; the x dismisses until their next message. -->
                <Border x:Name="AlertPill" Visibility="Collapsed" Margin="8,0,0,0" Height="22" CornerRadius="11"
                        Background="#FFFB8C00" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AlertOpenButton" Style="{StaticResource PillButton}" Padding="9,0,4,0"
                                Click="AlertOpen_Click">
                            <TextBlock x:Name="AlertText" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                       FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="AlertDismissButton" Style="{StaticResource PillButton}" Width="22"
                                FontFamily="{StaticResource IconFont}" FontSize="8" Content="&#xE711;"
                                ToolTip="Dismiss until their next message" Click="AlertDismiss_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Only visible while the page is off messages.google.com (sign-in, SSO). -->
                <Button x:Name="HomeButton" Style="{StaticResource ChromeButton}" FontSize="12" Visibility="Collapsed"
                        Content="&#xE80F;" ToolTip="Back to Messages" Click="HomeButton_Click" />
                <Button x:Name="MenuButton" Style="{StaticResource ChromeButton}" FontSize="12"
                        Content="&#xE712;" ToolTip="Menu" Click="MenuButton_Click" />
                <ToggleButton x:Name="DesktopsToggle" Style="{StaticResource ChromeToggle}"
                              Content="&#xE7C4;" ToolTip="Show on all desktops" Click="DesktopsToggle_Click" />
                <ToggleButton x:Name="TopmostToggle" Style="{StaticResource ChromeToggle}"
                              Content="&#xE718;" ToolTip="Always on top" Click="TopmostToggle_Click" />
                <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}"
                        Content="&#xE921;" ToolTip="Minimize" Click="MinimizeButton_Click" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" ToolTip="Close" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <wv2:WebView2 x:Name="Web" Grid.Row="1" />
    </Grid>
</Window>
